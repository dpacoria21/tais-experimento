    {
      "name": "02 Verificación",
      "description": "Consultas sin efectos. Úsalas antes y después de cada corrida para comprobar que:\nA final = A inicial − confirmadas × monto, B final = B inicial + confirmadas × monto, y ningún saldo es negativo.\n\nLa pestaña Console de Postman muestra los saldos en USD.",
      "item": [
        {
          "name": "Consultar cuenta A",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/balances/{{cuenta_a}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "balances",
                "{{cuenta_a}}"
              ]
            },
            "description": "balance está en unidades menores: 99000 = USD 990."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json.balance !== undefined) {",
                  "    const usd = Number(json.balance) / Number(json.precision || 100);",
                  "    console.log(pm.info.requestName + ': USD ' + usd);",
                  "    pm.test(\"Saldo no negativo (USD \" + usd + \")\", function () {",
                  "        pm.expect(usd).to.be.at.least(0);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
