    {
      "name": "03 Operaciones bajo prueba",
      "description": "Cada petición ejercita una parte distinta del manejo de concurrencia. Aquí se ejecutan de una en una (comprobación funcional); para medir concurrencia hay que lanzarlas en paralelo con una herramienta de carga.\n\nTodas mueven dinero real entre A y B.",
      "item": [
        {
          "name": "Transferir USD 1 de A a B (directo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/transactions",
              "host": [
                "{{base}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "description": "Caso base: bloqueo y actualización de dos saldos. skip_queue=true aplica la transferencia en la misma petición.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"{{cuenta_a}}\",\n  \"destination\": \"{{cuenta_b}}\",\n  \"amount\": 1,\n  \"precision\": 100,\n  \"currency\": \"USD\",\n  \"reference\": \"{{$guid}}\",\n  \"description\": \"Experimento A a B\",\n  \"allow_overdraft\": false,\n  \"skip_queue\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP esperado (201)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201]);",
                  "});",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json[\"transaction_id\"]) { pm.collectionVariables.set(\"transaction_id\", json[\"transaction_id\"]); }",
                  "if (json[\"reference\"]) { pm.collectionVariables.set(\"transaction_ref\", json[\"reference\"]); }",
                  "pm.test(\"Estado APPLIED\", function () { pm.expect(json.status).to.eql(\"APPLIED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Transferir USD 1 de B a A (directo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/transactions",
