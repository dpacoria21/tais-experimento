            "description": "Cuenta las transferencias confirmadas (total_count). Compáralo con el cambio de saldos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": [\n    {\n      \"field\": \"source\",\n      \"operator\": \"eq\",\n      \"value\": \"{{cuenta_a}}\"\n    },\n    {\n      \"field\": \"destination\",\n      \"operator\": \"eq\",\n      \"value\": \"{{cuenta_b}}\"\n    },\n    {\n      \"field\": \"status\",\n      \"operator\": \"eq\",\n      \"value\": \"APPLIED\"\n    }\n  ],\n  \"limit\": 100,\n  \"include_count\": true,\n  \"sort_by\": \"created_at\",\n  \"sort_order\": \"desc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const filas = Array.isArray(json) ? json : (json.data || []);",
                  "console.log(pm.info.requestName + ': ' + filas.length + ' filas' + (json.total_count !== undefined ? ', total ' + json.total_count : ''));"
                ]
              }
