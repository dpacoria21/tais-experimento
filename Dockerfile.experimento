FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOMAXPROCS=4 go build -p 4 -o /output/blnk ./cmd

# Incluye pg_dump para las funciones de backup del proyecto.
FROM postgres:16-bookworm
COPY --from=build /output/blnk /usr/local/bin/blnk
WORKDIR /app
EXPOSE 5001 5004
ENTRYPOINT ["blnk"]
CMD ["start"]
